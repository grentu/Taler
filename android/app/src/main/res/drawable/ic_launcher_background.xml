<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Multi-stop diagonal gradient: sky cyan -> Taler cobalt -> electric indigo -> midnight indigo -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="4"
                android:endX="102"
                android:endY="104">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FF2576FF" android:offset="0.32" />
                <item android:color="#FF4F46E5" android:offset="0.68" />
                <item android:color="#FF181242" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft top-left luminous sky highlight -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="18"
                android:centerY="14"
                android:gradientRadius="72">
                <item android:color="#44BAE6FD" android:offset="0.0" />
                <item android:color="#00BAE6FD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Subtle bottom-right violet depth bloom -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96"
                android:centerY="94"
                android:gradientRadius="66">
                <item android:color="#3D7C3AED" android:offset="0.0" />
                <item android:color="#007C3AED" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
