#include <windows.h>

// Same icon as the main app, so the single file looks like Taler in Explorer.
1 ICON "..\\runner\\resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,16,0
 PRODUCTVERSION 1,2,16,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "grentu"
            VALUE "FileDescription", "Taler"
            VALUE "FileVersion", "1.2.16"
            VALUE "InternalName", "Taler"
            VALUE "OriginalFilename", "Taler-Windows-x64.exe"
            VALUE "ProductName", "Taler"
            VALUE "ProductVersion", "1.2.16"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
